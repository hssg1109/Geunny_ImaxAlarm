# ── Discord (권장) ─────────────────────────────────────────
# 채널 설정 → 연동 → 웹후크 → 새 웹후크 → URL 복사
DISCORD_WEBHOOK_URL=

# ── Telegram (선택) ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 사내망 등 Telegram 차단 환경에서만 설정 (예: http://127.0.0.1:7890)
TELEGRAM_PROXY=

# ── CGV accessToken ────────────────────────────────────────
# DevTools → Application → Cookies → cgv.co.kr → accessToken 값 복사
ACCESS_TOKEN=
# CGV 전체 쿠키 (Cloudflare 우회용). api.cgv.co.kr 조회는 없어도 되지만,
# cgv.co.kr/api/v1/...(좌석선점/결제 등 booking.py가 쓰는 엔드포인트)는 이게 없으면 401 발생.
# DevTools → Network → CGV API 요청 클릭 → Request Headers → cookie 값 전체 복사
CGV_COOKIES=

# 고객번호 (선택, DevTools URL에서 custNo= 값)
CUST_NO=


# 확인할 날짜 (YYYYMMDD, 쉼표 구분)
WATCH_DATES=20260530,20260531

# ── 영화/상영관 ────────────────────────────────────────────
MOV_NO=30001210
SITE_NO=0013
CO_CD=A420
RTCTL_SCOP_CD=08

# ── 자동예매 (booking.py) ────────────────────────────────────
# config.json의 auto_book: true 와 함께 켜야 실제로 동작.
# DRY_RUN=true(기본값)면 좌석선점→즉시취소만 하고 관람권 적용/확정은 하지 않음.
# 실전 전환 시에만 false로 변경할 것.
DRY_RUN=true
# 사용할 영화관람권(기프트카드) 번호, 쉼표 구분. 2연석 기준이라 정확히 2개 필요.
# CGV 앱/웹 "마이 관람권함"에서 확인. 예: GIFTC_NOS=107280862298,107242050253
# 관람권이 좌석별 티켓 가격을 전액 커버하지 못하면(카드결제 필요) 자동예매는 안전하게 중단됨.
GIFTC_NOS=
