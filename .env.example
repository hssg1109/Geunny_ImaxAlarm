# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── CGV accessToken ────────────────────────────────────────
# DevTools → Application → Cookies → cgv.co.kr → accessToken 값 복사
ACCESS_TOKEN=

# 고객번호 (선택, DevTools URL에서 custNo= 값)
CUST_NO=

# ── 감시 설정 ──────────────────────────────────────────────
CHECK_INTERVAL_SECONDS=60

# 확인할 날짜 (YYYYMMDD, 쉼표 구분)
WATCH_DATES=20260530,20260531

# ── 영화/상영관 ────────────────────────────────────────────
MOV_NO=30001210
SITE_NO=0013
CO_CD=A420
RTCTL_SCOP_CD=08
