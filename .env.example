# ── Discord (권장) ─────────────────────────────────────────
# 채널 설정 → 연동 → 웹후크 → 새 웹후크 → URL 복사
DISCORD_WEBHOOK_URL=

# ── Telegram (선택) ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 사내망 등 Telegram 차단 환경에서만 설정 (예: http://127.0.0.1:7890)
TELEGRAM_PROXY=

# ── CGV accessToken ────────────────────────────────────────
# DevTools → Application → Cookies → cgv.co.kr → accessToken 값 복사
ACCESS_TOKEN=
# CGV 전체 쿠키 (Cloudflare 우회용, GCP 등 해외 서버에서 필수)
# DevTools → Network → CGV API 요청 클릭 → Request Headers → cookie 값 전체 복사
CGV_COOKIES=

# 고객번호 (선택, DevTools URL에서 custNo= 값)
CUST_NO=


# 확인할 날짜 (YYYYMMDD, 쉼표 구분)
WATCH_DATES=20260530,20260531

# ── 영화/상영관 ────────────────────────────────────────────
MOV_NO=30001210
SITE_NO=0013
CO_CD=A420
RTCTL_SCOP_CD=08
