# ── Telegram ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ── CGV Bearer 토큰 ────────────────────────────────────────
# 브라우저 DevTools → Network → searchSchByMov 요청 헤더에서 복사
# "Bearer " 이후 값만 입력
BEARER_TOKEN=

# 고객번호 (선택, DevTools URL에서 custNo= 값)
CUST_NO=

# ── 감시 설정 ──────────────────────────────────────────────
CHECK_INTERVAL_SECONDS=60

# 확인할 날짜 (YYYYMMDD, 쉼표 구분)
WATCH_DATES=20260530,20260531

# ── 영화/상영관 (기본값 유지 권장) ──────────────────────────
MOV_NO=30001210
SITE_NO=0013
CO_CD=A420
RTCTL_SCOP_CD=08
